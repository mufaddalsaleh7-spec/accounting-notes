const state = {
  token: localStorage.getItem('accountingnotes-token') || '',
  user: null,
  dashboard: null,
  companies: [],
  accounts: [],
  vouchers: [],
};

const app = document.getElementById('app');

function renderLogin() {
  app.innerHTML = `
    <div class="login-card">
      <div class="login-hero">
        <p class="eyebrow">ERP · Finance · Operations</p>
        <h1>Accounting Notes</h1>
        <p>Modern accounting software designed for fast bookkeeping, ledger control, and business reporting.</p>
        <div class="chips">
          <span>Multi-company</span>
          <span>Voucher entry</span>
          <span>Reports</span>
          <span>Audit trail</span>
        </div>
      </div>
      <div class="login-form">
        <h2>Welcome back</h2>
        <div class="muted">Sign in to access your books</div>
        <div id="loginAlert"></div>
        <label class="label" for="email">Email</label>
        <input id="email" class="input" type="email" value="admin@accountingnotes.local" />
        <label class="label" for="password">Password</label>
        <input id="password" class="input" type="password" value="admin123" />
        <button class="primary-btn" id="loginBtn">Sign in</button>
      </div>
    </div>
  `;

  document.getElementById('loginBtn').addEventListener('click', handleLogin);
}

async function handleLogin() {
  const email = document.getElementById('email').value;
  const password = document.getElementById('password').value;
  const alertBox = document.getElementById('loginAlert');

  try {
    const response = await fetch('/api/auth/login', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email, password }),
    });

    const data = await response.json();
    if (!response.ok) {
      alertBox.className = 'alert error';
      alertBox.textContent = data.error || 'Login failed.';
      return;
    }

    state.token = data.token;
    state.user = data.user;
    localStorage.setItem('accountingnotes-token', data.token);
    renderDashboard();
  } catch (error) {
    alertBox.className = 'alert error';
    alertBox.textContent = 'Unable to sign in. Please check the server.';
  }
}

async function fetchApi(path) {
  const response = await fetch(path, {
    headers: {
      Authorization: `Bearer ${state.token}`,
    },
  });

  if (response.status === 401) {
    localStorage.removeItem('accountingnotes-token');
    state.token = '';
    state.user = null;
    renderLogin();
    return null;
  }

  const data = await response.json();
  if (!response.ok) {
    throw new Error(data.error || 'Request failed');
  }
  return data;
}

async function renderDashboard() {
  try {
    const [dashboard, companies, accounts, vouchers] = await Promise.all([
      fetchApi('/api/dashboard'),
      fetchApi('/api/companies'),
      fetchApi('/api/accounts?companyId=cmp-demo'),
      fetchApi('/api/vouchers?companyId=cmp-demo'),
    ]);

    state.dashboard = dashboard;
    state.companies = companies || [];
    state.accounts = accounts || [];
    state.vouchers = vouchers || [];

    app.innerHTML = `
      <div class="dashboard">
        <header class="topbar">
          <div>
            <div class="brand">Accounting Notes</div>
          </div>
          <nav class="nav">
            <button class="tab">Dashboard</button>
            <button class="tab">Vouchers</button>
            <button class="tab">Accounts</button>
            <button class="tab">Reports</button>
          </nav>
          <div class="form-inline">
            <span class="user-pill">${state.user.name}</span>
            <button class="secondary-btn" id="logoutBtn">Logout</button>
          </div>
        </header>

        <section class="stats-grid">
          <div class="stat-card">
            <div class="stat-label">Accounts</div>
            <div class="stat-value">${dashboard.totalAccounts}</div>
          </div>
          <div class="stat-card">
            <div class="stat-label">Vouchers</div>
            <div class="stat-value">${dashboard.totalVouchers}</div>
          </div>
          <div class="stat-card">
            <div class="stat-label">Debit</div>
            <div class="stat-value">₹${dashboard.totalDebits.toLocaleString('en-IN')}</div>
          </div>
          <div class="stat-card">
            <div class="stat-label">Credit</div>
            <div class="stat-value">₹${dashboard.totalCredits.toLocaleString('en-IN')}</div>
          </div>
        </section>

        <section class="panel">
          <div class="panel-header">
            <h3>Company Overview</h3>
            <button class="secondary-btn">Create Company</button>
          </div>
          <div class="form-grid">
            <div>
              <div class="stat-label">Company</div>
              <div class="stat-value" style="font-size:1.2rem">${dashboard.companyName}</div>
            </div>
            <div>
              <div class="stat-label">Net Position</div>
              <div class="stat-value" style="font-size:1.2rem">₹${dashboard.netPosition.toLocaleString('en-IN')}</div>
            </div>
          </div>
        </section>

        <section class="panel">
          <div class="panel-header">
            <h3>Accounts</h3>
            <button class="secondary-btn">Add Account</button>
          </div>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Code</th>
                  <th>Name</th>
                  <th>Type</th>
                  <th>Opening</th>
                </tr>
              </thead>
              <tbody>
                ${state.accounts.map(account => `
                  <tr>
                    <td>${account.code}</td>
                    <td>${account.name}</td>
                    <td><span class="badge">${account.type}</span></td>
                    <td>₹${Number(account.openingBalance).toLocaleString('en-IN')}</td>
                  </tr>
                `).join('')}
              </tbody>
            </table>
          </div>
        </section>

        <section class="panel">
          <div class="panel-header">
            <h3>Recent Vouchers</h3>
            <button class="secondary-btn">New Voucher</button>
          </div>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Reference</th>
                  <th>Date</th>
                  <th>Type</th>
                  <th>Amount</th>
                </tr>
              </thead>
              <tbody>
                ${state.vouchers.slice(0, 6).map(voucher => {
                  const total = voucher.lines.reduce((sum, line) => sum + Number(line.debit || line.credit || 0), 0);
                  return `
                    <tr>
                      <td>${voucher.reference}</td>
                      <td>${voucher.date}</td>
                      <td>${voucher.voucherType}</td>
                      <td>₹${total.toLocaleString('en-IN')}</td>
                    </tr>
                  `;
                }).join('')}
              </tbody>
            </table>
          </div>
        </section>
      </div>
    `;

    document.getElementById('logoutBtn').addEventListener('click', () => {
      localStorage.removeItem('accountingnotes-token');
      state.token = '';
      state.user = null;
      renderLogin();
    });
  } catch (error) {
    console.error(error);
    app.innerHTML = `<div class="alert error">Unable to load dashboard. Please sign in again.</div>`;
    renderLogin();
  }
}

async function init() {
  if (!state.token) {
    renderLogin();
    return;
  }

  try {
    const user = await fetchApi('/api/auth/me');
    if (!user) {
      renderLogin();
      return;
    }
    state.user = user;
    renderDashboard();
  } catch {
    renderLogin();
  }
}

init();
